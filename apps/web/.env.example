# Everything VITE_ ships to the browser. Never put a secret here.
# Copy to apps/web/.env.local and set real values there (git-ignored). Details: docs/setup.md
# true = screens use typed mocks; false = they call Supabase and /api.
VITE_USE_MOCKS=true
# Supabase project URL (dashboard > Connect, or http://127.0.0.1:54321 for the local stack).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Public key for the browser (dashboard > Project Settings > API Keys > Publishable key).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Where the web app calls the API. Same origin on Vercel; `vercel dev` serves /api locally.
VITE_API_BASE_URL=/api
