# Everything VITE_ ships to the browser. Never put a secret here.
# Copy to apps/web/.env.local and set real values there (git-ignored).
VITE_USE_MOCKS=true
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Same origin on Vercel; `vercel dev` serves /api locally.
VITE_API_BASE_URL=/api
