{
  "regions": ["fra1"],
  "functions": {
    "api/pipeline/ocr.ts": {
      "maxDuration": 300,
      "includeFiles": "../../node_modules/.pnpm/{pdfjs-dist,tesseract.js,tesseract.js-core,@napi-rs+canvas}@*/node_modules/**"
    },
    "api/pipeline/extract.ts": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/router" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
