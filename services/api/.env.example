# Secret file: copy to services/api/.env.local for local runs. Never commit it.
# In Lambda the two secrets come from SSM Parameter Store:
#   /docspread/<env>/supabase-secret-key
#   /docspread/<env>/anthropic-api-key

# Database and auth
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# AI
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-5-5
ANTHROPIC_MODEL_EXTRACT=claude-opus-5-5
# AWS (local only: Lambda sets the region and uses its role)
AWS_PROFILE=docspread-dev
AWS_REGION=eu-central-1
S3_DOCUMENTS_BUCKET=docspread-dev-documents
S3_EXPORTS_BUCKET=docspread-dev-exports
TEXTRACT_SNS_TOPIC_ARN=arn:aws:sns:eu-central-1:<account-id>:<topic>
TEXTRACT_ROLE_ARN=arn:aws:iam::<account-id>:role/<role>
SES_FROM_ADDRESS=no-reply@<domain>
# App
ALLOWED_ORIGIN=http://localhost:5173
UPLOAD_MAX_BYTES=20971520
CLASSIFY_MIN_CONFIDENCE=0.7
