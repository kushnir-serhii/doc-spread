# Secret file: copy to services/api/.env.local for local runs. Never commit it.
# On Vercel the same names are set in the project's environment (Production and Preview).

# Database and auth
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# AI
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-5-5
ANTHROPIC_MODEL_EXTRACT=claude-opus-5-5
# Storage
STORAGE_DOCUMENTS_BUCKET=documents
STORAGE_EXPORTS_BUCKET=exports
# Pipeline trigger: same value as the Vault secret `pipeline_secret`; pg_net sends it in x-pipeline-secret
PIPELINE_SECRET=
# App
UPLOAD_MAX_BYTES=20971520
CLASSIFY_MIN_CONFIDENCE=0.7
