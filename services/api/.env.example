# Secret file: copy to services/api/.env.local for local runs. Never commit it. Details: docs/setup.md
# On Vercel the same names are set in the project's environment (Production and Preview).

# Database and auth
# Supabase project URL (dashboard > Connect, or http://127.0.0.1:54321 locally).
SUPABASE_URL=https://<project-ref>.supabase.co
# Server key that bypasses row-level security (dashboard > API Keys > Secret key). Never log it.
SUPABASE_SECRET_KEY=sb_secret_...
# Public keys the API uses to check user tokens: <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# AI
# Anthropic API key (console.anthropic.com > API keys).
ANTHROPIC_API_KEY=sk-ant-...
# Model that picks the document type (cheap and fast).
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-5-5
# Model that extracts the field values.
ANTHROPIC_MODEL_EXTRACT=claude-opus-5-5
# Storage
# Private Supabase Storage bucket for uploaded files (created by a migration).
STORAGE_DOCUMENTS_BUCKET=documents
# Private bucket for export files (created by a migration; no code reads it yet).
STORAGE_EXPORTS_BUCKET=exports
# Pipeline trigger: random secret, same value as the Vault secret `pipeline_secret`; pg_net sends it in x-pipeline-secret.
# Generate with: openssl rand -base64 48
PIPELINE_SECRET=
# App
# Largest upload the API accepts, in bytes (20971520 = 20 MB; matches the bucket limit).
UPLOAD_MAX_BYTES=20971520
# Below this confidence (0 to 1) a document stays Unclassified.
CLASSIFY_MIN_CONFIDENCE=0.7
# Demo login for seed-demo and the smoke scripts (local only, never on Vercel). seed-demo writes both.
DEMO_USER_EMAIL=demo@docspread.dev
DEMO_USER_PASSWORD=
